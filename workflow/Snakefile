configfile: "workflow/config/config.yaml"

import json
from pathlib import Path

STEPS = json.loads(Path("workflow/config/steps.json").read_text())
DATA = config["data_root"]
RESULTS = config["results_root"]
RSCRIPT = config["rscript"]
ALL_OUTPUTS = [f"{RESULTS}/{s['id']}/{o}" for s in STEPS for o in s["outputs"]]

rule all:
    default_target: True
    input:
        ALL_OUTPUTS

rule step_01_proteomics_pca:
    input:
        data=[f"{DATA}/proteomics_matrix.tsv", f"{DATA}/proteomics_annotation.csv", f"{DATA}/proteomics_gene_mapping.rds"],
        code="workflow/scripts/01_proteomics_pca.R",
        common="workflow/scripts/common.R",
        spec="workflow/config/steps.json"
    output:
        artifacts=[f"{RESULTS}/01_proteomics_pca/04-plot-PCA.pdf"],
        session=f"{RESULTS}/01_proteomics_pca/sessionInfo.txt"
    conda:
        "envs/analysis.yaml"
    threads: 1
    log:
        f"{RESULTS}/logs/01_proteomics_pca.log"
    params:
        stage="01_proteomics_pca",
        data=DATA,
        out=f"{RESULTS}/01_proteomics_pca",
        rscript=RSCRIPT
    shell:
        "{params.rscript:q} --vanilla {input.code:q} {params.data:q} {params.out:q} > {log:q} 2>&1"

